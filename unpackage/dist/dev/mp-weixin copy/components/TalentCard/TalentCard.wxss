
.talent-card.data-v-3738fd9c {
  width: 100%;
  box-sizing: border-box;
  background-color: white;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(63, 142, 247, 0.06);
}
.talent-card-bg.data-v-3738fd9c {
  position: absolute;
  top: 0;
  right: 0;
  width: 128px;
  height: 128px;
  background: rgba(74, 144, 226, 0.05);
  border-radius: 50%;
  filter: blur(48px);
}
.talent-content.data-v-3738fd9c {
  position: relative;
  z-index: 1;
}
.talent-user.data-v-3738fd9c {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16px;
}
.talent-avatar-wrapper.data-v-3738fd9c {
  position: relative;
  margin-right: 16px;
}
.talent-avatar.data-v-3738fd9c {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  border: 4px solid #f2f4f7;
}
.online-indicator.data-v-3738fd9c {
  position: absolute;
  bottom: -2px;
  right: -2px;
  width: 16px;
  height: 16px;
  background-color: #3ED6A9;
  border-radius: 50%;
  border: 2px solid white;
}
.talent-user-info.data-v-3738fd9c {
  flex: 1;
}
.talent-name-row.data-v-3738fd9c {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.talent-name.data-v-3738fd9c {
  font-size: 16px;
  font-weight: bold;
  color: #191c1e;
}
.talent-school.data-v-3738fd9c {
  font-size: 10px;
  color: #4A90E2;
  text-transform: uppercase;
  letter-spacing: 1px;
}
.talent-status.data-v-3738fd9c {
  background-color: rgba(107, 251, 203, 0.1);
  padding: 4px 8px;
  border-radius: 6px;
}
.status-text.data-v-3738fd9c {
  font-size: 10px;
  font-weight: bold;
  color: #006c52;
}
.talent-bio.data-v-3738fd9c {
  font-size: 12px;
  color: #414753;
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 16px;
  display: block;
}
.talent-footer.data-v-3738fd9c {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16px;
  border-top: 1px solid #f2f4f7;
  margin-bottom: 16px;
}
.talent-skill-tags.data-v-3738fd9c {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.skill-tag.data-v-3738fd9c {
  font-size: 12px;
  background-color: #E8F0FE;
  color: #4A90E2;
  padding: 2px 8px;
  border-radius: 10px;
  margin-right: 5px;
  margin-bottom: 5px;
}

/* 预览卡片样式 */
.talent-track.data-v-3738fd9c {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 12px;
  background-color: #f2f4f7;
  border-radius: 8px;
}
.track-label.data-v-3738fd9c {
  font-size: 12px;
  color: #717784;
  font-weight: bold;
}
.track-value.data-v-3738fd9c {
  font-size: 12px;
  color: #4A90E2;
  font-weight: bold;
  margin-left: 4px;
}
.no-skills.data-v-3738fd9c {
  font-size: 12px;
  color: #717784;
  font-style: italic;
}
.action-buttons.data-v-3738fd9c {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}
.action-btn.data-v-3738fd9c {
  flex: 1;
  padding: 12px;
  border-radius: 24px;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s;
}
.action-btn.invite.data-v-3738fd9c {
  background: linear-gradient(135deg, #005bb2 0%, #1173db 100%);
  color: white;
  box-shadow: 0 4px 12px rgba(0, 91, 178, 0.2);
}
.action-btn.greet.data-v-3738fd9c {
  background-color: #f2f4f7;
  color: #414753;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}
.action-btn.data-v-3738fd9c:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0, 91, 178, 0.25);
}
.action-btn.greet.data-v-3738fd9c:hover {
  background-color: #e8f0fe;
  box-shadow: 0 4px 12px rgba(74, 144, 226, 0.15);
}
.btn-text.data-v-3738fd9c {
  color: inherit;
}
